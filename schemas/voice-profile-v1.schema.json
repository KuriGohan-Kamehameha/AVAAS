{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avaas.invalid/schemas/voice-profile-v1.schema.json",
  "title": "AVAAS immutable CosyVoice shared-identity profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "profile_id",
    "version",
    "speaker_id",
    "aliases",
    "engine",
    "audio",
    "files",
    "provenance",
    "validation",
    "evaluation",
    "target_compatibility",
    "promotable",
    "fixture",
    "created_at",
    "author"
  ],
  "properties": {
    "schema": {"const": "avaas/voice-profile@v1"},
    "artifact_id": {"$ref": "#/$defs/slug"},
    "profile_id": {"const": "satraj-piranesi"},
    "version": {"$ref": "#/$defs/semver"},
    "speaker_id": {"const": "satraj"},
    "aliases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": {
            "id": "satraj",
            "speaker_id": "satraj",
            "default_presentation": "satraj.en-ca.neutral"
          }
        },
        {
          "const": {
            "id": "piranesi",
            "speaker_id": "satraj",
            "default_presentation": "piranesi.en-gb.neutral"
          }
        }
      ],
      "items": false
    },
    "engine": {
      "const": {
        "name": "cosyvoice3",
        "code_repository": "FunAudioLLM/CosyVoice",
        "code_commit": "074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc",
        "model_repository": "FunAudioLLM/Fun-CosyVoice3-0.5B",
        "model_snapshot": "29e01c4e8d000f4bcd70751be16fa94bf3d85a18",
        "model_license": "Apache-2.0",
        "mode": "zero-shot"
      }
    },
    "audio": {"const": {"sample_rate_hz": 24000, "channels": 1, "sample_format": "pcm_s16le"}},
    "files": {"type": "object", "minProperties": 6, "maxProperties": 6},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "references_manifest_sha256",
        "corpus_manifest_sha256",
        "split_sha256",
        "dsp_sha256",
        "source_commits"
      ],
      "properties": {
        "references_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "split_sha256": {"$ref": "#/$defs/sha256"},
        "dsp_sha256": {"$ref": "#/$defs/sha256"},
        "source_commits": {"$ref": "#/$defs/sourceCommits"}
      }
    },
    "validation": {
      "const": {"cpu": {"passed": true}, "cuda": {"passed": true}}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "passed", "thresholds", "measured"],
      "properties": {
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "passed": {"const": true},
        "thresholds": {"type": "object", "minProperties": 1, "maxProperties": 32},
        "measured": {"type": "object", "minProperties": 1, "maxProperties": 32}
      }
    },
    "target_compatibility": {
      "const": [
        "kudzu-vox/expressive@v1",
        "openai/audio-speech@v1",
        "astroclaw/pcm24@v1"
      ]
    },
    "promotable": {"type": "boolean"},
    "fixture": {"type": "boolean"},
    "created_at": {"$ref": "#/$defs/created"},
    "author": {"const": "CPCS"}
  },
  "allOf": [
    {
      "if": {"properties": {"fixture": {"const": true}}},
      "then": {"properties": {"promotable": {"const": false}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sourceCommits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avaas", "piranesi_workspace"],
      "properties": {
        "avaas": {"$ref": "#/$defs/commit"},
        "piranesi_workspace": {"$ref": "#/$defs/commit"}
      }
    }
  }
}
